# Install as /etc/afplatform.env; edit hostname and browser path first.
# For the systemd template ONLY. Direct local exe / make run does not read this file.
# No Google passwords, Cookies or API Tokens belong in this file.
AF_DATA=/var/lib/afplatform
AF_LISTEN=127.0.0.1:8788
AF_PUBLIC_URL=https://fold.example.org
AF_BROWSER=/usr/bin/google-chrome
AF_MAX_BROWSERS=3
AF_BROWSER_IDLE=2m
# Manual Google login needs a protected desktop owned by the SAME service user.
# DISPLAY=:1
