# Optional Compose interpolation file, used with --env-file deploy/docker.env.
# The container entrypoint converts AF_* values to Go command-line flags.
# Native afplatform binaries still do not automatically read dotenv files.
AF_PORT=8788
AF_PUBLIC_URL=http://127.0.0.1:8788
AF_MAX_BROWSERS=3
AF_BROWSER_IDLE=2m
AF_DESKTOP=1
AF_DESKTOP_PORT=6080
AF_VNC_PORT=5900
# For team access: set AF_PUBLIC_URL=https://fold.example.org and configure
# the host's HTTPS reverse proxy to http://127.0.0.1:8788, preserving Host.
